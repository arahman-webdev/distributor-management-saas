# ==============================================================================
# DISTRIBO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/distribo?schema=public"

# 2. BETTER AUTH CONFIGURATION
BETTER_AUTH_SECRET="your-32-character-secret-key-goes-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. PLATFORM SUPER ADMIN BOOTSTRAP
SUPER_ADMIN_BOOTSTRAP_SECRET="your-bootstrap-secret-minimum-16-chars"
ADMIN_EMAIL="admin@distribo.app"
ADMIN_PASSWORD="ChangeThisPassword123!"
ADMIN_NAME="Platform Super Admin"

# 4. APPLICATION BRANDING & BANGLADESH LOCALIZATION
NEXT_PUBLIC_APP_NAME="Distribo"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_DEFAULT_LOCALE="bn"

# 5. ENVIRONMENT & RUNTIME
NODE_ENV="development"
PORT=3000
